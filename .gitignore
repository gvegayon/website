# Quarto build files
/.quarto/
/_site/
# execute.freeze is false, so this is a stale leftover rather than a cache
/_freeze/
*_cache/
*_files/

# R files
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*~

# Node modules (if using)
node_modules/

# Build artifacts
*.log
**/*.quarto_ipynb

# Per-item detail pages generated by R/build_pages.R (`make pages`).
# Build output, not data -- the data lives in papers.toml / software.toml.
/research/
/software/
